        {
          "id": "channels",
          "type": "table",
          "title": "渠道",
          "titleKey": "channels",
          "tool": "channels",
          "path": "/channels",
          "columns": [
            {
              "key": "id",
              "title": "渠道",
              "titleKey": "colChannel"
            },
            {
              "key": "configured",
              "title": "已配置",
              "titleKey": "colConfigured",
              "format": "bool"
            },
            {
              "key": "target",
              "title": "发送到",
              "titleKey": "colTarget"
            },
            {
              "key": "missing",
              "title": "还需设置",
              "titleKey": "colMissing"
            }
          ],
          "rowActions": [
            {
              "id": "test",
              "title": "发送测试",
              "titleKey": "actTest",
              "icon": "send",
              "tool": "send",
              "arguments": {
                "channel": "{id}",
                "title": "OpsPanel",
                "body": "Test message from OpsPanel"
              },
              "when": {
                "key": "configured",
                "in": [
                  "true"
                ]
              }
            }
          ]
        }
      ],
      "tools": {
        "channels": {
          "title": "查看渠道",
          "description": "列出已配置和未配置的通知渠道"
