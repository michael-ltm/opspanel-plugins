{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.michael-ltm/notify",
  "title": "通知渠道",
  "description": "把消息推送到 ntfy、Telegram 或飞书机器人，让 Agent 和面板例程能通知到你。至少配置一个渠道。",
  "version": "0.1.2",
  "repository": {
    "url": "https://github.com/michael-ltm/opspanel-plugins",
    "source": "github",
    "subfolder": "cmd/notify"
  },
  "websiteUrl": "https://github.com/michael-ltm/opspanel-plugins/tree/main/cmd/notify",
  "packages": [
    {
      "registryType": "mcpb",
      "identifier": "https://github.com/michael-ltm/opspanel-plugins/releases/download/notify-v0.1.2/notify-linux-amd64",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "NTFY_URL",
          "description": "ntfy 服务器地址。",
          "default": "https://ntfy.sh"
        },
        {
          "name": "NTFY_TOPIC",
          "description": "ntfy 主题；填了就启用 ntfy。"
        },
        {
          "name": "NTFY_TOKEN",
          "description": "ntfy 访问令牌（受保护的主题才需要）。",
          "isSecret": true
        },
        {
          "name": "TELEGRAM_BOT_TOKEN",
          "description": "Telegram 机器人令牌（找 @BotFather 创建）。",
          "isSecret": true
        },
        {
          "name": "TELEGRAM_CHAT_ID",
          "description": "接收消息的 Telegram 会话 ID。"
        },
        {
          "name": "FEISHU_WEBHOOK",
          "description": "飞书群机器人的 Webhook 地址。",
          "isSecret": true
        },
        {
          "name": "FEISHU_SECRET",
          "description": "飞书机器人开启了签名校验时，填写签名密钥。",
          "isSecret": true
        }
      ],
      "version": "0.1.2",
      "fileSha256": "ac911587a439e34697d4856d6ab56bf4ac5cb076f47049f2d4d9c211b5e0618c"
    }
