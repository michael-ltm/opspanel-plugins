      "i18n": {
        "en": {
          "description": "This machine's Tailscale state and the nodes in the tailnet: online or not, IP, OS, last seen, and whether the connection is direct or relayed. Read-only.",
          "online": "Nodes online",
          "peers": "Nodes",
          "colName": "Name",
          "colIP": "IP",
          "colOS": "OS",
          "colOnline": "Online",
          "colLastSeen": "Last seen",
          "colConnection": "Connection",
          "actCopyIp": "Copy IP",
          "tool.status.title": "This machine",
          "tool.status.description": "This machine's Tailscale state and the tailnet overview",
          "tool.peers.title": "Peers",
          "tool.peers.description": "Every node in the tailnet"
        }
      },
      "ui": [
        {
          "id": "online",
          "type": "stat",
          "title": "在线节点",
          "titleKey": "online",
          "tool": "status",
          "path": "/online",
          "refresh": 30
        },
        {
          "id": "peers",
          "type": "table",
          "title": "节点",
          "titleKey": "peers",
          "tool": "peers",
          "path": "/peers",
          "refresh": 30,
          "columns": [
            {
              "key": "name",
              "title": "名称",
              "titleKey": "colName"
            },
            {
              "key": "ip",
              "title": "IP",
              "titleKey": "colIP"
            },
            {
              "key": "os",
              "title": "系统",
              "titleKey": "colOS"
            },
            {
              "key": "online",
              "title": "在线",
              "titleKey": "colOnline",
              "format": "bool"
            },
            {
              "key": "lastSeen",
              "title": "最后在线",
              "titleKey": "colLastSeen",
              "format": "time"
            },
            {
              "key": "connection",
              "title": "连接",
              "titleKey": "colConnection",
              "format": "badge"
            }
          ],
          "rowActions": [
            {
              "id": "copy",
              "title": "复制 IP",
              "titleKey": "actCopyIp",
              "icon": "copy",
              "copy": "{ip}",
              "unless": {
                "key": "ip",
                "in": [
                  ""
                ]
              }
            }
          ]
        }
      ],
      "tools": {
        "status": {
          "title": "本机状态",
          "description": "本机的 Tailscale 状态和 tailnet 概况"
        },
        "peers": {
          "title": "节点列表",
          "description": "tailnet 里的所有节点"
        }
      }
    }
  }
