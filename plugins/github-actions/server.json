{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.michael-ltm/github-actions",
  "title": "GitHub Actions",
  "description": "在面板里看 GitHub Actions：最近的运行、失败任务出错位置的日志、Release 列表，也能重跑失败的任务。需要一个 GitHub 令牌。",
  "version": "0.1.2",
  "repository": {
    "url": "https://github.com/michael-ltm/opspanel-plugins",
    "source": "github",
    "subfolder": "cmd/github-actions"
  },
  "websiteUrl": "https://github.com/michael-ltm/opspanel-plugins/tree/main/cmd/github-actions",
  "packages": [
    {
      "registryType": "mcpb",
      "identifier": "https://github.com/michael-ltm/opspanel-plugins/releases/download/github-actions-v0.1.2/github-actions-linux-amd64",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "GITHUB_TOKEN",
          "description": "GitHub 令牌。细粒度令牌给 Actions 读权限即可查看，重跑还要 Actions 写权限，看 Release 要 Contents 读权限。",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "GITHUB_REPO",
          "description": "要看的仓库（owner/name），多个用逗号分隔。不填就看你最近推送过的 5 个仓库。"
        }
      ],
      "version": "0.1.2",
      "fileSha256": "1a25bddd2080c3cacc96632c07b027f132aed1b6f1d74043ac8dd53dc769c7a1"
    }
  ],
  "_meta": {
    "io.github.opspanel/plugin": {
      "artifacts": {
        "darwin/amd64": {
          "url": "https://github.com/michael-ltm/opspanel-plugins/releases/download/github-actions-v0.1.2/github-actions-darwin-amd64",
          "sha256": "1b6cbec1136a84fc9bbac08f6cdeb48cc85c93af738991065d4a122d27f04f05"
        },
        "darwin/arm64": {
          "url": "https://github.com/michael-ltm/opspanel-plugins/releases/download/github-actions-v0.1.2/github-actions-darwin-arm64",
          "sha256": "349a3d8bce4ccb699dfbaeeb45314a3dc89e770755f05af0f3e73464959525eb"
        },
        "linux/amd64": {
          "url": "https://github.com/michael-ltm/opspanel-plugins/releases/download/github-actions-v0.1.2/github-actions-linux-amd64",
          "sha256": "1a25bddd2080c3cacc96632c07b027f132aed1b6f1d74043ac8dd53dc769c7a1"
        },
        "linux/arm64": {
          "url": "https://github.com/michael-ltm/opspanel-plugins/releases/download/github-actions-v0.1.2/github-actions-linux-arm64",
          "sha256": "7b028ce980473431e8764606fd2688e5524f56c9850f9178cfebac16b470039f"
        },
        "windows/amd64": {
          "url": "https://github.com/michael-ltm/opspanel-plugins/releases/download/github-actions-v0.1.2/github-actions-windows-amd64.exe",
          "sha256": "6d4e5cb99d261e13e34f12a4db4a2411495d84953832b65d0f43b808cb8ce966"
        },
        "windows/arm64": {
          "url": "https://github.com/michael-ltm/opspanel-plugins/releases/download/github-actions-v0.1.2/github-actions-windows-arm64.exe",
          "sha256": "12a87a9d1eb0daf3c3334f6b26ffc5e54267b02373f7e345ad722f294073e068"
        }
      },
      "i18n": {
        "en": {
          "description": "Watch GitHub Actions from the panel: recent runs, the log around where a failed job broke, and releases; re-run failed jobs. Needs a GitHub token.",
          "runs": "Recent runs",
          "colRepo": "Repository",
          "colWorkflow": "Workflow",
          "colBranch": "Branch",
          "colState": "State",
          "colStarted": "Started",
          "actFailLog": "Failure log",
          "actRerun": "Re-run failed",
          "actOpen": "Open",
          "tool.runs_list.title": "Recent runs",
          "tool.runs_list.description": "The latest workflow runs",
          "tool.run_logs.title": "Failure log",
          "tool.run_logs.description": "Log lines around where a failed job broke",
          "tool.run_rerun.title": "Re-run failed jobs",
          "tool.run_rerun.description": "Run the failed jobs of a run again",
          "tool.releases_list.title": "Releases",
          "tool.releases_list.description": "The repository's latest releases",
          "env.GITHUB_TOKEN.title": "Access token",
          "env.GITHUB_TOKEN.description": "GitHub token. A fine-grained token with Actions read lets you look; re-running also needs Actions write, and releases need Contents read.",
          "env.GITHUB_REPO.title": "Default repository",
          "env.GITHUB_REPO.description": "Repositories to watch (owner/name), comma-separated. Leave empty to see your 5 most recently pushed repositories."
        }
      },
      "ui": [
        {
          "id": "runs",
          "type": "table",
          "title": "最近的运行",
          "titleKey": "runs",
          "tool": "runs_list",
          "path": "/runs",
          "refresh": 60,
          "columns": [
            {
              "key": "repo",
              "title": "仓库",
              "titleKey": "colRepo"
            },
            {
              "key": "workflow",
              "title": "工作流",
              "titleKey": "colWorkflow"
            },
            {
              "key": "branch",
              "title": "分支",
              "titleKey": "colBranch"
            },
            {
              "key": "state",
              "title": "状态",
              "titleKey": "colState",
              "format": "badge"
            },
            {
              "key": "createdAt",
              "title": "开始于",
              "titleKey": "colStarted",
              "format": "time"
            }
          ],
          "rowActions": [
            {
              "id": "logs",
              "title": "失败日志",
              "titleKey": "actFailLog",
              "icon": "logs",
              "tool": "run_logs",
              "arguments": {
                "repo": "{repo}",
                "run_id": "{id}"
              },
              "display": "dialog",
              "resultPath": "/failedJobs",
              "when": {
                "key": "state",
                "in": [
                  "failure",
                  "cancelled",
                  "timed_out",
                  "startup_failure"
                ]
              }
            },
            {
              "id": "rerun",
              "title": "重跑失败项",
              "titleKey": "actRerun",
              "icon": "refresh",
              "tool": "run_rerun",
              "arguments": {
                "repo": "{repo}",
                "run_id": "{id}"
              },
              "confirm": true,
              "when": {
                "key": "state",
                "in": [
                  "failure",
                  "cancelled",
                  "timed_out",
                  "startup_failure"
                ]
              }
            },
            {
              "id": "open",
              "title": "打开",
              "titleKey": "actOpen",
              "icon": "external",
              "link": "{url}",
              "unless": {
                "key": "url",
                "in": [
                  ""
                ]
              }
            }
          ]
        }
      ],
      "tools": {
        "runs_list": {
          "title": "最近的运行",
          "description": "各仓库最近的工作流运行"
        },
        "run_logs": {
          "title": "失败日志",
          "description": "只取失败步骤附近的日志"
        },
        "run_rerun": {
          "title": "重跑失败的任务",
          "description": "重新运行一次运行里失败的任务"
        },
        "releases_list": {
          "title": "发布列表",
          "description": "仓库最近的 Release"
        }
      },
      "settings": {
        "GITHUB_TOKEN": {
          "title": "访问令牌"
        },
        "GITHUB_REPO": {
          "title": "默认仓库"
        }
      }
    }
  }
}
