      "identifier": "https://github.com/michael-ltm/opspanel-plugins/releases/download/github-actions-v0.1.0/github-actions-linux-amd64",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "GITHUB_TOKEN",
          "description": "GitHub 令牌。细粒度令牌给 Actions 读权限即可查看，重跑还要 Actions 写权限，看 Release 要 Contents 读权限。",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "GITHUB_REPO",
          "description": "要看的仓库（owner/name），多个用逗号分隔。不填就看你最近推送过的 5 个仓库。"
        }
